      {
        "id": "retrieval-path",
        "label": "Retrieve context",
        "focus": ["query", "stamp", "router", "candidates", "hybrid", "context"],
        "note": "The capsule narrows the search; lexical and semantic scores recover precise evidence."
      },
      {
        "id": "relation-path",
        "label": "Follow relationships",
        "focus": ["relations", "product", "stamp", "context"],
        "note": "Typed directional links contribute a bounded diffusion view without replacing the source graph."
