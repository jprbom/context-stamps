include stamps.py LICENSE CITATION.cff CONTEXT_STAMPS.md program.md CONTRIBUTING.md SECURITY.md
include .gitleaks.toml
include CHANGELOG.md
recursive-include docs *.md *.svg *.png *.html *.json *.txt
recursive-include examples *.py *.json
recursive-include tests *.py
recursive-include benchmarks *.py *.md *.json
recursive-include skills *.md
global-exclude *.visual-check*

recursive-include experiments *.py
include experiments/eval-requirements.txt
recursive-include evidence *.json *.jsonl *.md *.txt *.py
exclude evidence/controller-v1/results.json
include evidence/controller-v1/*.json.gz
include evidence/controller-v1/checkpoints/selected-fp32.safetensors
include evidence/controller-v1/checkpoints/selected-int8.safetensors
include evidence/controller-v1/checkpoints/recurrent-29.safetensors
include evidence/controller-v2/*.json.gz
include evidence/controller-v2/models/*.safetensors
recursive-include evidence/runtime-v1 *.json.gz
recursive-include evidence/enterprise-context-v1 *.log
recursive-include evidence/enterprise-state-v1 *.log
recursive-include evidence/enterprise-audit-v1 *.log
recursive-include evidence/enterprise-execution-v1 *.log
recursive-include evidence/enterprise-storage-v1 *.log
recursive-include evidence/enterprise-incremental-v1 *.log
recursive-include evidence/acquisition-v1 *.json.gz *.log
recursive-include evidence/engineering-sources-v1 *.gz
recursive-include evidence/general-learning-v1 *.log
